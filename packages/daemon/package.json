{
  "name": "@thinkite/daemon",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "macOS daemon for sidecode \u2014 wraps Claude Agent SDK and exposes it to mobile clients",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "thinkite": "./dist/bin/thinkite.js",
    "sidecode": "./dist/bin/thinkite.js"
  },
  "files": [
    "dist",
    "scripts/*.plist"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "dev": "bun --watch src/bin/thinkite.ts up",
    "pair": "bun src/bin/thinkite.ts pair",
    "build": "tsc -b tsconfig.json && chmod +x ./dist/bin/thinkite.js",
    "typecheck": "tsc -b tsconfig.json",
    "start": "node ./dist/bin/thinkite.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@thinkite/protocol": "workspace:*",
    "diff": "^9.0.0",
    "node-datachannel": "^0.32.3",
    "p-limit": "^7.3.0",
    "partysocket": "^1.1.19",
    "qrcode": "^1.5.4",
    "simple-git": "^3.36.0",
    "ws": "^8.18.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
